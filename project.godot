; Godot project configuration file.
; Edit in the Godot editor when possible.
config_version=5

[application]
config/name="Cell Invader"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7")

[display]

[display/window]
size/viewport_width=430
size/viewport_height=760
size/window_width_override=430
size/window_height_override=760
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

